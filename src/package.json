{
  "name": "gas-ai-english-trainer",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "check:data": "node scripts/build-data.mjs --check",
    "test": "npm run check:data && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser/acceptance.mjs",
    "format": "prettier --write server client scripts tests package.json appsscript.json",
    "format:check": "prettier --check server client scripts tests package.json appsscript.json",
    "check": "npm test && npm run format:check",
    "push": "npm run check && clasp push"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@playwright/test": "^1.64.1",
    "jsdom": "^24.1.3",
    "yaml": "^2.6.1",
    "prettier": "^3.6.2"
  }
}
